rule "o365 threat intel enrichment"
when
    has_field("ClientIP")
then
    // ClientIP is not always a bare address. Exchange admin records carry a
    // port ("20.105.93.26:13872"), Azure service traffic is often IPv6
    // ("2603:1026:c0b:1c1b::5"). Strip the port from IPv4 only - splitting on
    // ":" would destroy an IPv6 address.
    let raw = to_string($message.ClientIP);
    let ip = regex_replace("^((?:\\d{1,3}\\.){3}\\d{1,3}):\\d+$", raw, "$1");
    set_field("ClientIP_clean", ip);

    // Tor exit nodes. The list is maintained by the Threat Intelligence plugin
    // and refreshed automatically while tor_enabled is true.
    let tor = lookup_value("tor-exit-node-list", ip);
    set_field("src_is_tor", is_not_null(tor));

    // Spamhaus DROP/EDROP: hijacked or criminal-controlled netblocks.
    let drop = lookup_value("spamhaus-drop", ip);
    set_field("src_in_spamhaus_drop", to_string(drop, "false"));
end
